POSTGRES_USER=dormfix_local
POSTGRES_PASSWORD=
DORMFIX_SECURITY_JWT_ISSUER=http://localhost:8080
DORMFIX_SECURITY_JWT_AUDIENCE=dormfix-api
DORMFIX_SECURITY_JWT_KEY_ID=local-dev-key
